    public static void LoadCustomerData()
        {
            string connectionString = @"Data Source=.\SQLEXPRESS;Initial Catalog=YourDatabaseName;Integrated Security=True";
            string query = "SELECT FirstName, LastName, Address, CarType, FuelType, Age FROM Customers WHERE CustomerId = @CustomerId";

            using (SqlConnection conn = new SqlConnection(connectionString))
            using (SqlCommand cmd = new SqlCommand(query, conn))
            {
                cmd.Parameters.AddWithValue("@CustomerId", someCustomerId); // Replace with actual ID

                try
                {
                    conn.Open();
                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        if (reader.Read())
                        {
                            textBox1.Text = reader["FirstName"].ToString();
                            // ... assign other fields
                        }
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Error loading customer data: " + ex.Message);
                }
            }
        }
    }

    internal class textBox1
    {
        internal static string Text;
    }
}
