        private void LoadCustomerData()
        {
            string connectionString = @"Data Source=.\SQLEXPRESS;Initial Catalog=YourDatabaseName;Integrated Security=True";
            string query = @"SELECT TOP 1 FirstName, SecondField, ThirdField, ComboBox1, ComboBox2, ComboBox3, NumericUpDown2
                             FROM Customers
                             ORDER BY CustomerID DESC"; // Adjust as needed

            using (SqlConnection conn = new SqlConnection(connectionString))
            using (SqlCommand cmd = new SqlCommand(query, conn))
            {
                try
                {
                    conn.Open();
                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        if (reader.Read())
                        {
                            textBox1.Text = reader["FirstName"].ToString();
                            textBox2.Text = reader["SecondField"].ToString();
                            textBox3.Text = reader["ThirdField"].ToString();
                            comboBox1.SelectedItem = reader["ComboBox1"].ToString();
                            comboBox2.SelectedItem = reader["ComboBox2"].ToString();
                            comboBox3.SelectedItem = reader["ComboBox3"].ToString();
                            decimal numericValue;
                            if (decimal.TryParse(reader["NumericUpDown2"].ToString(), out numericValue))
                                numericUpDown2.Value = numericValue;
                        }
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Database error: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }
