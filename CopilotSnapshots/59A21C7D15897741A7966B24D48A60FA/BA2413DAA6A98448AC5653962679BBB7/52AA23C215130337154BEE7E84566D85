        private bool Button1_Click(object sender, EventArgs e)
        {
            if(!IsFormComplete())
            {
                MessageBox.Show("Please complete all fields before submitting.", "Incomplete Form", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            SaveCustomerData();
            LoadCustomerData();
            MessageBox.Show("Congratulation You Have Booked Your Ride,Thank You", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
            return true;
        }

        private bool IsFormComplete()
        {
            // Check if all required fields are filled/selected
            return !string.IsNullOrWhiteSpace(textBox1.Text)
                && !string.IsNullOrWhiteSpace(textBox2.Text)
                && !string.IsNullOrWhiteSpace(textBox3.Text)
                && comboBox1.SelectedItem != null
                && comboBox2.SelectedItem != null
                && comboBox3.SelectedItem != null;
        }

        private void SaveCustomerData()
        {
            // Get connection string (if using App.config)
            // string connectionString = ConfigurationManager.ConnectionStrings["CustomerDb"].ConnectionString;

            // Or use a direct connection string for learning/demo:
            string connectionString = @"Data Source=.\SQLEXPRESS;Initial Catalog=YourDatabaseName;Integrated Security=True";

            string query = @"INSERT INTO Customers 
                (FirstName, SecondField, ThirdField, ComboBox1, ComboBox2, NumericUpDown2)
                VALUES (@FirstName, @SecondField, @ThirdField, @ComboBox1, @ComboBox2, @NumericUpDown2)";

            using (SqlConnection conn = new SqlConnection(connectionString))
            using (SqlCommand cmd = new SqlCommand(query, conn))
            {
                cmd.Parameters.AddWithValue("@FirstName", textBox1.Text);
                cmd.Parameters.AddWithValue("@SecondField", textBox2.Text);
                cmd.Parameters.AddWithValue("@ThirdField", textBox3.Text);
                cmd.Parameters.AddWithValue("@ComboBox1", comboBox1.SelectedItem?.ToString() ?? "");
                cmd.Parameters.AddWithValue("@ComboBox2", comboBox2.SelectedItem?.ToString() ?? "");
                cmd.Parameters.AddWithValue("@NumericUpDown2", (int)numericUpDown2.Value);

                try
                {
                    conn.Open();
                    cmd.ExecuteNonQuery();
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Database error: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }

